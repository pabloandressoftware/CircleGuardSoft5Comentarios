global:
  resolve_timeout: 5m
route:
  receiver: discord
  group_by: [alertname, namespace]
  group_wait: 10s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - matchers:
        - severity="critical"
      receiver: discord
receivers:
  - name: discord
    discord_configs:
      - webhook_url: "__DISCORD_WEBHOOK__"
        send_resolved: true
        title: '{{ .CommonAnnotations.summary }}'
        message: |
          {{ range .Alerts }}{{ .Annotations.description }}
          {{ end }}
