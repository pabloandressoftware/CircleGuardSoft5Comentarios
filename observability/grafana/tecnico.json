{
  "uid": "cg-tecnico",
  "title": "CircleGuard · Técnico",
  "tags": ["circleguard", "tecnico"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Servicios arriba",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(up{namespace=~\"circleguard-(dev|stage|prod)\"})", "instant": true }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 8 }] } } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Targets caídos",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "count(up{namespace=~\"circleguard-(dev|stage|prod)\"} == 0)", "instant": true }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Solicitudes por segundo",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "refId": "A", "expr": "sum by (application) (rate(http_server_requests_seconds_count{namespace=~\"circleguard-(dev|stage|prod)\"}[5m]))", "legendFormat": "{{application}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latencia p95 por servicio",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, application) (rate(http_server_requests_seconds_bucket{namespace=~\"circleguard-(dev|stage|prod)\"}[5m])))", "legendFormat": "{{application}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Errores 5xx",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\",namespace=~\"circleguard-(dev|stage|prod)\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{namespace=~\"circleguard-(dev|stage|prod)\"}[5m])), 0.001)", "legendFormat": "ratio 5xx" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.05 }] } } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "JVM heap",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "refId": "A", "expr": "sum by (application) (jvm_memory_used_bytes{area=\"heap\",namespace=~\"circleguard-(dev|stage|prod)\"}) / clamp_min(sum by (application) (jvm_memory_max_bytes{area=\"heap\",namespace=~\"circleguard-(dev|stage|prod)\"}), 1)", "legendFormat": "{{application}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Reinicios de contenedores (10m)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        { "refId": "A", "expr": "sum by (namespace, pod) (increase(kube_pod_container_status_restarts_total{namespace=~\"circleguard-(dev|stage|prod)\"}[10m]))", "legendFormat": "{{namespace}}/{{pod}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Duración del scrape",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        { "refId": "A", "expr": "scrape_duration_seconds{namespace=~\"circleguard-(dev|stage|prod)\"}", "legendFormat": "{{namespace}}/{{job}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ]
}
