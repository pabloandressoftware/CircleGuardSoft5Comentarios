#!/usr/bin/env bash
set -euo pipefail
# El volumen y la EIP se asocian después de crear la instancia. Esperar antes
# de instalar k3s evita arrancar con datos efímeros o sin conexión a Internet.
disk="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_${volume_serial}"
for attempt in $(seq 1 180); do
  if [[ -e "$disk" ]]; then break; fi
  if [[ -b /dev/xvdf ]]; then disk=/dev/xvdf; break; fi
  sleep 5
done
test -b "$disk"
if ! blkid "$disk" >/dev/null 2>&1; then mkfs.ext4 "$disk"; fi
mkdir -p /var/lib/rancher
uuid=$(blkid -s UUID -o value "$disk")
printf 'UUID=%s /var/lib/rancher ext4 defaults,nofail 0 2\n' "$uuid" >> /etc/fstab
mount /var/lib/rancher
mkdir -p /etc/systemd/system/k3s.service.d
cat > /etc/systemd/system/k3s.service.d/10-storage.conf <<'SYSTEMD'
[Unit]
RequiresMountsFor=/var/lib/rancher
[Service]
ExecStartPre=/usr/bin/mountpoint -q /var/lib/rancher
SYSTEMD

for attempt in $(seq 1 180); do
  if curl --connect-timeout 5 -fsSL https://get.k3s.io -o /tmp/install-k3s.sh; then break; fi
  sleep 5
done
test -s /tmp/install-k3s.sh
mkdir -p /etc/rancher/k3s
printf '%s' '${registries_b64}' | base64 -d > /etc/rancher/k3s/registries.yaml
chmod 600 /etc/rancher/k3s/registries.yaml
cat > /etc/rancher/k3s/config.yaml <<'K3S'
write-kubeconfig-mode: "0600"
tls-san:
  - "${public_ip}"
node-external-ip: "${public_ip}"
secrets-encryption: true
log: /var/log/k3s.log
K3S
INSTALL_K3S_VERSION='${k3s_version}' sh /tmp/install-k3s.sh
# Traefik, metrics-server, CoreDNS, ServiceLB y local-path vienen con k3s.
# HU-18/HU-19 instalan aplicaciones y HU-24 los dashboards/alertas.
curl --retry 5 -fsSL 'https://amazoncloudwatch-agent-${region}.s3.${region}.amazonaws.com/ubuntu/amd64/latest/amazon-cloudwatch-agent.deb' -o /tmp/cloudwatch.deb
dpkg -i /tmp/cloudwatch.deb
printf '%s' '${agent_b64}' | base64 -d > /opt/aws/amazon-cloudwatch-agent/etc/circleguard.json
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 -s -c file:/opt/aws/amazon-cloudwatch-agent/etc/circleguard.json
