# Copia este archivo fuera del repo y reemplaza los valores antes de usarlo.
CI_JENKINS_USER=operador
CI_JENKINS_PASSWORD=
CI_SONAR_INITIAL_PASSWORD=
# Usa una contraseña larga con mayúsculas, minúsculas, números y símbolos.
CI_SONAR_PASSWORD=
CI_SONAR_DB_PASSWORD=
CI_NEXUS_PASSWORD=
CI_NEXUS_USER=admin

# HU-10: usuario que aprueba el despliegue a prod (input de Jenkins).
# Cambia la contrasena por una propia antes de una entrega real.
CI_APPROVER_USER=aprobador
CI_APPROVER_PASSWORD=

# HU-10: cuenta de salud con la que corre Playwright en dev.
CI_E2E_HEALTH_USER=health_user
CI_E2E_HEALTH_PASSWORD=password

# PAT de GitHub con lectura sobre el repositorio privado (scope repo).
# Deja CI_GITHUB_CREDENTIALS_ID vacío si el repositorio es público.
# Para uno privado, define el token y usa circleguard-github como ID.
CI_GITHUB_CREDENTIALS_ID=
CI_GITHUB_USER=x-access-token
CI_GITHUB_TOKEN=

# HU-11: notificaciones de fallo por correo. Con Gmail usa una contrasena de
# aplicacion (Cuenta de Google > Seguridad > Verificacion en 2 pasos > Contrasenas
# de aplicaciones), nunca la contrasena normal. CI_NOTIFY_EMAILS: lista separada por comas.
CI_SMTP_HOST=smtp.gmail.com
CI_SMTP_PORT=465
CI_SMTP_USER=
CI_SMTP_PASSWORD=
CI_NOTIFY_EMAILS=

# Puertos del host. Los servicios quedan enlazados a loopback.
CI_JENKINS_PORT=8181
CI_SONAR_PORT=9000
CI_NEXUS_PORT=8081
CI_REGISTRY_PORT=5000
