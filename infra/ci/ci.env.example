# Copia este archivo fuera del repo y reemplaza los valores antes de usarlo.
CI_JENKINS_USER=operador
CI_JENKINS_PASSWORD=
CI_SONAR_INITIAL_PASSWORD=
# Usa una contraseña larga con mayúsculas, minúsculas, números y símbolos.
CI_SONAR_PASSWORD=
CI_SONAR_DB_PASSWORD=
CI_NEXUS_PASSWORD=

# Puertos del host. Los servicios quedan enlazados a loopback.
CI_JENKINS_PORT=8181
CI_SONAR_PORT=9000
CI_NEXUS_PORT=8081
CI_REGISTRY_PORT=5000
